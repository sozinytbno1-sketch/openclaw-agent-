# OpenClaw Agent - Environment Configuration
# ==========================================

# 9Router Configuration (OpenAI-compatible endpoint)
NINEROUTER_API_KEY=not-needed
OPENAI_API_KEY=not-needed

# OpenClaw Home
OPENCLAW_HOME=/home/ubuntu
OPENCLAW_STATE_DIR=/home/ubuntu/.openclaw

# Python Virtual Environment
VIRTUAL_ENV=/home/ubuntu/openclaw-agent/.venv
PATH=/home/ubuntu/openclaw-agent/.venv/bin:$PATH

# Browser Configuration
OPENCLAW_BROWSER_HEADLESS=1

# Workspace
OPENCLAW_WORKSPACE=/home/ubuntu/openclaw-agent/workspace
